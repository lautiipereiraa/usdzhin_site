# Copiar a .env y ajustar. Todas las variables tienen default en los compose,
# así que el stack de dev levanta incluso sin .env.

# Prefijo de imágenes, contenedores y redes.
APP_NAME=usdzhin

# Puerto del dev server en el host.
FRONTEND_PORT=5173

# Interfaz donde se publica el dev server.
#   127.0.0.1 (default) → solo local, se accede por túnel SSH:
#                         ssh -L 5173:127.0.0.1:5173 usuario@host
#   0.0.0.0             → accesible desde internet. Sin TLS ni auth:
#                         usarlo solo en un entorno donde eso sea aceptable.
BIND_HOST=127.0.0.1

# UID/GID del usuario del host, para que el bind mount de dev no genere
# archivos con dueño equivocado. Verificar con: id -u && id -g
HOST_UID=1001
HOST_GID=1001

# Google Analytics 4 measurement ID (formato G-XXXXXXXXXX).
# Vacío = analytics desactivado. Dejarlo vacío en desarrollo para no
# ensuciar las métricas de producción.
VITE_GA_ID=
